<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <style>
        html, body {
            height: 100%;
        }

        .main-container {
            height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        .navbar {
            border-bottom: solid 1px rgba(0, 0, 0, 0.1);
        }

        .sidebar {
            border-right: solid 1px rgba(0, 0, 0, 0.1);
            width: 220px;
        }

        .container-fluid {
            flex-grow: 1;
        }

        .container-sub {
            display: flex;
            flex-grow: 1;
        }

        .menu-item {
            padding: 10px;
            cursor: pointer;
            border-radius: 5px;
            margin: 0 0 3px 0;
            line-height: 29px;
            letter-spacing: -0.1px;
            font-family: "Roboto", "sans-serif";
            font-weight: 400;
        }

        .menu-item i{
            margin-right: 10px;
            font-size: 16px;
        }

        .menu-item:hover {
            background: rgb(234, 234, 234);
        }

        .menu-item.active {
            background: rgb(230, 244, 254);
            color: rgb(13, 116, 206);
            font-weight: bold;
            border: solid 1.5px rgba(0, 32, 251, 0.16);
        }

        .c-height{
            height: 87vh;
        }

        .card-body{
            display: flex;
            padding: 0;
        }

        .contato{

        }
        #contatos_lista{
            padding: 5px;
        }

        .c-user{
            display: flex;flex-direction: row;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
            padding: 10px;
            border-radius: 5px;
        }
        .c-user:hover{
            background: rgb(234, 234, 234);
        }


    </style>
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <a class="navbar-brand" href="#">
                    <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                         class="d-inline-block align-text-top">
                    FUCAPI Acolhe
                </a>

            </div>
            <div>Meu Dia FUCAPI</div>

            <div style="display:flex;align-items: center">
                <div style="margin: auto 10px auto 10px">
                    Conected
                    <i class="fa-solid fa-circle" style="color: chartreuse"></i>
                </div>
                65 Bpm
                <i class="fa-solid fa-heart" style="color: red;margin: auto"></i>
            </div>
        </div>

    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div style="padding:10px;">
                <ul class="nav flex-column">
                    <li class="menu-item active">
                        <i class="fa-solid fa-igloo"></i>
                        Meu Dia FUCAPI
                    </li>
                    <li class="menu-item">
                        <i class="fa-solid fa-people-arrows"></i>
                        Conecta FUCAPI
                    </li>
                    <li class="menu-item">
                        <i class="fa-solid fa-spa"></i>
                        Espaço Calma
                    </li>
                    <li class="menu-item">
                        <i class="fa-solid fa-id-card-clip"></i>
                        Perfil de Usuário
                    </li>
                </ul>
            </div>
        </div>
        <div style="padding:10px;flex-grow: 1;">
            <div class="card c-height">
                <div class="card-header">
                    Chat Assincrono
                </div>
                <div class="card-body">
                    <div style="display: flex;flex-direction: row;flex-grow:1;">
                        <div style="width: 300px;border-right: solid 1px rgb(200,200,200);">
                            <div style="padding: 10px 10px 10px 15px;
                                        border-bottom: solid 1px rgb(200,200,200);">Contatos</div>
                            <div id="contatos_lista">
                                <div class="contato">
                                    <div class="c-user" style="">
                                        <div style="display: flex;
                                                    flex-direction: row;
                                                    justify-content: space-between;
                                                    align-items: center;">
                                            <div style="width: 40px;height: 40px;background-color: rgb(200,200,200);
                                                    border-radius: 25px;
                                                    text-align: center;
                                                    align-content: center;">
                                                A
                                            </div>
                                            <div style="margin-left: 5px">
                                                <div>Prof. Adriana Fernandes</div>
                                                <div>Calculo II</div>
                                            </div>
                                        </div>
                                        <div style="width: 30px;height: 25px;background-color: rgb(255,140,95);
                                                    border-radius: 12px;
                                                    text-align: center;
                                                    align-content: center;
                                                    font-size: 13px;
                                                    margin-left: 5px;">
                                            1
                                        </div>
                                    </div>
                                    <div class="c-user">
                                        <div style="display: flex;
                                                    flex-direction: row;
                                                    justify-content: space-between;
                                                    align-items: center;">
                                            <div style="width: 40px;height: 40px;background-color: rgb(200,200,200);
                                                    border-radius: 25px;
                                                    text-align: center;
                                                    align-content: center;">
                                                A
                                            </div>
                                            <div style="margin-left: 5px">
                                                <div>Prof. Adriana Fernandes</div>
                                                <div>Calculo II</div>
                                            </div>
                                        </div>
                                        <div style="width: 30px;height: 25px;background-color: rgb(255,140,95);
                                                    border-radius: 12px;
                                                    text-align: center;
                                                    align-content: center;
                                                    font-size: 13px;
                                                    margin-left: 5px;">
                                            1
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="display:flex;flex-grow: 1; flex-direction: column;">
                            <div style="padding: 10px 10px 10px 15px;
                                        border-bottom: solid 1px rgb(200,200,200);font-weight: bold;">
                                chat
                            </div>
                            <div style="display: flex;flex-direction: column;flex-grow: 1">
                                <div style="flex-grow: 1;padding: 10px 10px 10px 15px;">
                                    <div style="display: flex;"></div>
                                </div>
                                <div style="padding: 10px 10px 10px 15px;">
                                    <input class="form-control" type="text" placeholder="Default input" aria-label="default input example">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>