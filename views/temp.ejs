<!--                                            Lorem Ipsum is simply dummy text of the printing and typesetting industry-->
<!--                                        </div>-->
<!--                                    </div>-->
                                </div>

                            </div>
                            <div class="chat-conversation-input">
                                <div class="chat-file">
                                    <i class="fa-solid fa-paperclip"></i>
                                </div>
                                <div class="chat-input">
                                    <input id="message-text" class="form-control" type="text" placeholder="Digite uma mensagem"
                                           aria-label="default input example" disabled onkeydown="handleKeyPress(event)">
                                </div>
                                <div>
                                    <button class="btn btn-primary" type="button" onclick="sendMessage()">
                                        <i class="fa-solid fa-paper-plane"></i> Enviar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
