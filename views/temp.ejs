                            <div id="contatos_lista">

                            </div>
                        </div>
                        <div class="chat-main">
                            <div id="chat-user-title" class="chat-main-title">

                            </div>
                            <div class="chat-main-content" id="scroll-messages">
                                <div class="chat-conversation" id="messages-container">
                                    <div style="align-content: center;
                                                  text-align: center;
                                                  justify-content: center;
                                                  display: flex;
                                                  flex-direction: column;
                                                  flex-grow: 1;">
                                        <i class="material-symbols-outlined" style="font-size: 80px">chat</i>
                                        <h1 style="font-size: 30px">Nenhuma conversa selecionada</h1>
                                    </div>
