<body>

<div class="dashboard-container">
    <aside class="sidebar">
        <div class="logo-container">
            <img src="/images/logo 64x64.png" alt="Logo FUCAPI Acolhe" class="logo">
            <div class="logo-text">
                <div>
                    <h3>FUCAPI </h3>
                </div>
                <div>
                    <h3 class="side">Acolhe</h3>
                </div>
            </div>

        </div>
        <nav class="main-menu">
            <ul>
                <li class="menu-item">
                    <i class="fas fa-home"></i>
                    <a href="/agenda/minha-agenda">Meu Dia FUCAPI</a>
                </li>
                <li class="menu-item active">
                    <i class="fas fa-comments"></i>
                    <a href="#">Conecta FUCAPI</a>
                </li>
                <li class="menu-item">
                    <i class="fas fa-spa"></i>
                    <a href="#">Espaço Calma</a>
                </li>
                <li class="menu-item">
                    <i class="fas fa-cog"></i>
                    <a href="#">Configurações</a>
                </li>
            </ul>
        </nav>
    </aside>

    <main class="main-content">
        <div class="header-main">
            <h2>Conecta FUCAPI</h2>
            <div class="header-right">
                <div class="pulseira-status">
                    <div class="pulseira-info">
                        <i class="fa-solid fa-heart-pulse"></i>
                        <span>Acolhe Sense</span>
                        <span>Pulseira</span>
                    </div>
                    <div class="pulseira-connected">
                        <i class="fa-solid fa-cloud"></i>
                        <span>Connected</span>
                    </div>
                </div>
                <div class="calm-status">
                    <span>75%</span>
                    <span>Calmo</span>
                </div>
            </div>
        </div>

        <div class="content-grid">
            <div class="chat-section card">
                <div class="card-title">
                    <h4>Chat Direto e Assíncrono</h4>
                </div>
                <div class="chat-list" id="chat-users">
                    <div class="chat-grid">
                        <div class="chat-user-cart">
                            <div class="chat-user-row" onclick="alerta()">
                                <a href="" >
                                    <span>A</span>
                                </a>
                                <div class="chat-user-info">
                                    <div class="chat-user-name">Prof. Gabriel Oliveira</div>
                                    <div class="chat-user-sub">Calculo II</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>

                    </div>
                </div>
            </div>

            <aside class="profile-section card">
                <div class="card-title">
                    <h4>Meu Perfil Necessidades</h4>
                </div>
                <div class="profile-content">
                </div>
            </aside>
        </div>
    </main>
</div>
