<!--                </div>-->
<!--            <% } %>-->
        </div>


    </nav>
    <div class="container-sub">
        <div class="main-content">
            <div  class="container text-center">
                <div id="bem-vindo" class="row visible-div">
                    <div class="col">
                        <span class="material-symbols-outlined" style="color: #003687;font-size: 50px;margin-top: 30px;">hand_gesture</span>
                        <h1 class="q-bem-vindo">Bem-vindo(a) ao Fucapi Acolhe!</h1>
                        <div style="width: 500px;margin: auto;margin-top: 10px;">
                            Para começarmos, faremos algumas perguntas rápidas. Suas respostas nos
                            ajudarão a personalizar o nosso sistema para a sua necessidades e, com a
                            sua permissão, fornecerão informações valiosas para a equipe de apoio
                            psicopedagógico.</br></br>
                            Suas respostas são confidenciais.
                        </div>
                        <div style="margin-top: 50px;">
                            <button id="questionario-iniciar" type="button" class="btn btn-primary btn-lg" style="background-color: #003687;">
                                <strong>Iniciar</strong>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="questionario-form" class="row justify-content-center hidden-div" >
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header">
                                <h2 class="text-center mb-0">Questionário de Sensibilidades</h2>
                            </div>
                            <div class="card-body">
                                <form id="questionarioForm" class="hide">

                                    <!-- Perguntas -->
                                    <div id="perguntasContainer">
                                        <!-- As perguntas serão carregadas aqui via JavaScript -->
                                    </div>



                                    <!-- Botão Enviar -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg" id="btnEnviar">
                                            <span class="spinner-border spinner-border-sm d-none" id="spinner"></span>
                                            Enviar Questionário
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/survey.js"></script>
<script src="/javascripts/navigation.js"></script>
