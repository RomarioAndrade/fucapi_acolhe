<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                             class="d-inline-block align-text-top">
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-top: 4px;margin-right:10px; ">headphones</span>
                    Sons Relaxantes
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <div style="display:flex;align-items: center">
                    <div style="margin: auto 10px auto 10px;text-align: center;align-items: center;">
                        <span class="material-symbols-outlined" style="margin-top: 4px;">aod_watch</span>
                    </div>
                    <div id="connectionStatus">Conectado</div>
                    <div id="currentBpm">65 Bpm</div>
                </div>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <%- include('partials/sidebar')%>
        </div>


        <div class="main-content">
            <div class="container">
                <div class="row g-4 justify-content-center">
                    <div class="col-12 col-md-10 col-lg-12">
                        <div class="card shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4 class="mb-0">Sons Relaxante</h4>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-md-5 mb-3 mb-md-0">
                                    <div class="mb-2">Playlist</div>
                                    <ul id="playlist" class="list-group">
                                        <!-- Tracks serão injetadas pelo JS -->
                                    </ul>

                                    <div class="mt-3">
                                        <label class="form-label">Adicionar som próprio</label>
                                        <input id="fileInput" class="form-control form-control-sm" type="file" accept="audio/*" multiple>
                                        <div class="form-text">Você pode selecionar vários arquivos. Eles serão adicionados à playlist localmente.</div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-7">
                                    <div class="mb-2">Player</div>
                                    <div class="border rounded p-3 bg-white">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="me-3" style="width:64px;height:64px;background:#e9ecef;border-radius:.5rem;display:flex;align-items:center;justify-content:center;">♪</div>
                                            <div>
                                                <div id="currentTitle" class="track-title">—</div>
                                                <div id="currentArtist" class="small-muted">—</div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div id="progressWrap" class="w-100">
                                                <div id="progress" class="progress">
                                                    <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between small-muted mt-1">
                                                <div id="currentTime">00:00</div>
                                                <div id="duration">00:00</div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-center gap-3 mb-2">
                                            <button id="prevBtn" class="btn btn-outline-secondary btn-sm" title="Anterior">
                                                <span class="material-symbols-outlined" style="align-items: center;display: flex;">skip_previous</span>
                                            </button>
                                            <button id="playBtn" class="btn btn-primary btn-sm px-3" title="Play / Pause">Play</button>
                                            <button id="nextBtn" class="btn btn-outline-secondary btn-sm" title="Próximo">
                                                <span class="material-symbols-outlined" style="align-items: center;display: flex;">skip_next</span>
                                            </button>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex gap-2 align-items-center">
                                                <label class="form-check-label me-2 small-muted">Volume</label>
                                                <input id="volume" type="range" min="0" max="1" step="0.01" value="0.8">
                                            </div>

                                            <div class="d-flex gap-2 align-items-center">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="loopToggle">
                                                    <label class="form-check-label small-muted" for="loopToggle">Loop</label>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="shuffleToggle">
                                                    <label class="form-check-label small-muted" for="shuffleToggle">Shuffle</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-3 small-muted">
                                            <strong>Dica:</strong> clique no item da playlist para tocar. Arraste o progresso para buscar.
                                        </div>

                                        <!-- Elemento audio escondido -->
                                        <audio id="audio" preload="metadata"></audio>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/relax.js"></script>
<script src="/javascripts/navigation.js"></script>
</body>
</html>