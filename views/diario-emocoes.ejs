<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                             class="d-inline-block align-text-top">
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-right: 10px">theater_comedy</span>
                    Diario Emoções
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <div style="display:flex;align-items: center">
                    <div style="margin: auto 10px auto 10px;text-align: center;align-items: center;">
                        <span class="material-symbols-outlined" style="margin-top: 4px;">aod_watch</span>
                        Conectado
                        <i class="fa-solid fa-circle" style="color: chartreuse;margin-left: 5px;"></i>
                    </div>
                    65 Bpm
                    <i class="fa-solid fa-heart" style="color: red;margin: auto"></i>
                </div>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item" onclick="navigation('dashboard')">
                        <span class="material-symbols-outlined">space_dashboard</span>
                        Dashboard
                    </li>
                    <li id="meudiafucapi" class="menu-item active" onclick="navigation('meudiafucapi')">
                        <span class="material-symbols-outlined">clear_day</span>
                        Meu Dia FUCAPI
                    </li>
                    <li id="conectafucapi" class="menu-item" onclick="navigation('conectafucapi')">
                        <span class="material-symbols-outlined">diversity_2</span>
                        Conecta FUCAPI

                    </li>
                    <li id="espacocalma" class="menu-item">
                        <span class="material-symbols-outlined">psychiatry</span>
                        Espaço Calma
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">ent</span>
                        Perfil de Usuário
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">notifications</span>
                        Notificações
                    </li>
                    <% if(user.papel !== 'aluno' ){ %>
                        <li class="menu-item">
                            <i class="fa-solid fa-table-list"></i>
                            Lista Alunos
                        </li>
                        <li class="menu-item">
                            <i class="fa-solid fa-message"></i>
                            Chat
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="main-content">
            <div class="container mt-2">
                <!-- Nova Entrada -->
                <div id="newEntrySection">
                    <div class="card shadow-sm col-9" style="margin: 0 auto 15px auto;">
                        <div class="card-header bg-white">
                            <h4 class="mb-0"></i> Nova Entrada no Diário</h4>
                        </div>
                        <div class="card-body diary">

                            <div class="mb-4">
                                <h5>Como você está se sentindo?</h5>
                                <div class="row g-3 emotionsGrid" id="emotionsGrid">

                                </div>
                            </div>

                            <div class="mb-4" id="intensitySection" style="display: none;">
                                <h5>Intensidade da emoção</h5>

                                <input type="range" class="intensity-slider" id="emotionIntensity" min="1" max="10"
                                       value="5">
                                <div class="d-flex justify-content-between">
                                    <small>Leve</small>
                                    <small>Moderada</small>
                                    <small>Intensa</small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5>O que pode estar Influenciando?</h5>
                                <div class="d-flex flex-wrap mb-2">
                                    <div class="" role="group" aria-label="Basic checkbox toggle button group">
                                        <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck1">Provas/Trabalhos</label>

                                        <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck2">Interação Social</label>

                                        <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck3">Barulho/Ambiente</label>

                                        <input type="checkbox" class="btn-check" id="btncheck4" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck4">Mudança de Rotina</label>

                                        <input type="checkbox" class="btn-check" id="btncheck5" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck5">Cansaço</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>O que está acontecendo? Diário do Dia</h5>
                                <textarea class="form-control" id="entryDescription" rows="4"
                                          placeholder="Descreva o que está sentindo e o que aconteceu..."></textarea>
                            </div>

                            <div class="mb-4">
                                <h5>Como posso lidar com isso?</h5>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 1..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Depois de refletir, como você se sente agora?</h5>
                            </div>
                            <div class="mb-4">
                                <div class="row g-3 emotionsGrid" id="emotionsGrid">

                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Você ainda precisa de ajuda?</h5>
                                <div>
                                    Busque ajuda presencialmente nas salas: <strong>D-19 ou D-01</strong>
                                </div>

                            </div>

                        </div>


                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-secondary me-md-2" id="clearEntryBtn">Limpar</button>
                            <button class="btn btn-primary" id="saveEntryBtn">Salvar Entrada</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
<script>
    // Emoções disponíveis
    const emotions = [
        {id: 1, name: "Feliz", icon: "sentiment_excited", color: "emotion-color-1"},
        {id: 2, name: "Calmo", icon: "sentiment_calm", color: "emotion-color-2"},
        {id: 3, name: "Neutro", icon: "sentiment_neutral", color: "emotion-color-3"},
        {id: 4, name: "Ansioso", icon: "sentiment_stressed", color: "emotion-color-4"},
        {id: 5, name: "Triste", icon: "sentiment_dissatisfied", color: "emotion-color-5"},
        {id: 6, name: "Raiva", icon: "sentiment_extremely_dissatisfied", color: "emotion-color-6"},
        {id: 7, name: "Aliviado", icon: "sentiment_content", color: "emotion-color-7"},
    ];

    // Inicialização da aplicação
    document.addEventListener('DOMContentLoaded', function () {
        initializeEmotionsGrid();
    });

    // Inicializa a grade de emoções
    function initializeEmotionsGrid() {
        const emotionsGrid = document.querySelectorAll('.emotionsGrid');
        emotionsGrid.forEach(emotion => {
            renderEmotionsGrid(emotion);
        })
    }

    function renderEmotionsGrid(emotionsGrid) {
        emotions.forEach(emotion => {
            const col = document.createElement('div');
            col.className = 'col-6 col-md-4 col-lg-2';

            const card = document.createElement('div');
            card.className = `card emotion-card text-center p-3 ${emotion.color}`;
            card.dataset.emotionId = emotion.id;

            card.innerHTML = `
                    <div class="emotion-icon">
                        <i class="material-symbols-outlined ">${emotion.icon}</i>
                    </div>
                    <h6>${emotion.name}</h6>
                `;

            card.addEventListener('click', function () {
                selectEmotion(emotion.id);
            });

            col.appendChild(card);
            emotionsGrid.appendChild(col);
        });
    }

    // Seleciona uma emoção
    function selectEmotion(emotionId) {
        selectedEmotion = emotionId;

        // Remove a seleção anterior
        document.querySelectorAll('.emotion-card').forEach(card => {
            card.classList.remove('selected-emotion');
        });

        // Adiciona a seleção à emoção clicada
        const selectedCard = document.querySelector(`.emotion-card[data-emotion-id="${emotionId}"]`);
        selectedCard.classList.add('selected-emotion');
    }

    function saveEntry() {
        if (!selectedEmotion) {
            alert('Por favor, selecione uma emoção.');
            return;
        }

        const entry = {
            id: Date.now(),
            dateTime: dateTime,
            location: location,
            emotion: selectedEmotion,
            intensity: parseInt(intensity),
            description: description,
            sensoryInputs: allSensoryInputs,
            strategies: allStrategies
        };

        diaryEntries.push(entry);
        localStorage.setItem('diaryEntries', JSON.stringify(diaryEntries));

        alert('Entrada salva com sucesso!');
        clearEntryForm();
        updateEntriesView();
    }

    // Limpa o formulário de nova entrada
    function clearEntryForm() {
        selectedEmotion = null;
        selectedSensoryInputs = [];
        selectedStrategies = [];

        document.getElementById('entryDateTime').value = '';
        document.getElementById('entryLocation').value = '';
        document.getElementById('emotionIntensity').value = 5;
        document.getElementById('entryDescription').value = '';
        document.getElementById('customSensory').value = '';
        document.getElementById('customStrategy').value = '';

        document.querySelectorAll('.emotion-card').forEach(card => {
            card.classList.remove('selected-emotion');
        });

        document.getElementById('intensitySection').style.display = 'none';

        document.querySelectorAll('.btn-sensory').forEach(btn => {
            if (btn.classList.contains('btn-primary')) {
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline-primary');
            }
            if (btn.classList.contains('btn-success')) {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            }
        });
    }

</script>
</body>
</html>