<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
<!--                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"-->
<!--                             class="d-inline-block align-text-top">-->
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-right: 10px">theater_comedy</span>
                    Diario Emoções
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <%- include('partials/cardio')%>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <%- include('partials/sidebar')%>
        </div>

        <div class="main-content">
            <div class="container mt-2">
                <!-- Nova Entrada -->
                <div id="newEntrySection">
                    <div class="card shadow-sm col-9" style="margin: 0 auto 15px auto;">
                        <div class="card-header bg-white">
                            <h4 class="mb-0"></i> Nova Entrada no Diário</h4>
                        </div>
                        <div class="card-body diary">

                            <div class="mb-4">
                                <h5>Como você está se sentindo?</h5>
                                <div class="row g-3 emotionsGrid" id="emotionsGrid">

                                </div>
                            </div>

                            <div class="mb-4">
                                <h5>O que pode estar Influenciando?</h5>
                                <div class="d-flex flex-wrap mb-2">
                                    <div id="influencias" class="" role="group" aria-label="Basic checkbox toggle button group">
                                        <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off" value="Provas/Trabalhos">
                                        <label class="btn btn-outline-primary" for="btncheck1">Provas/Trabalhos</label>

                                        <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off" value="Interação Social">
                                        <label class="btn btn-outline-primary" for="btncheck2">Interação Social</label>

                                        <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off" value="Barulho/Ambiente">
                                        <label class="btn btn-outline-primary" for="btncheck3">Barulho/Ambiente</label>

                                        <input type="checkbox" class="btn-check" id="btncheck4" autocomplete="off" value="Mudança de Rotina">
                                        <label class="btn btn-outline-primary" for="btncheck4">Mudança de Rotina</label>

                                        <input type="checkbox" class="btn-check" id="btncheck5" autocomplete="off" value="Cansaço">
                                        <label class="btn btn-outline-primary" for="btncheck5">Cansaço</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>O que está acontecendo? Diário do Dia</h5>
                                <textarea class="form-control" id="diario_text" rows="4"
                                          placeholder="Descreva o que está sentindo e o que aconteceu..."></textarea>
                            </div>

                            <div class="mb-4">
                                <h5>Como posso lidar com isso?</h5>
                                <div class="mb-4">
                                    <textarea class="form-control" id="possibilidade1" rows="1"
                                              placeholder="Possibilidade 1..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="possibilidade2" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="possibilidade3" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Depois de refletir, como você se sente agora?</h5>
                            </div>
                            <div class="mb-4">
                                <div class="row g-3" id="emotionsGrid2">
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-1" data-emotion-id="1">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_satisfied</i>
                                            </div>
                                            <h6>Feliz</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-2" data-emotion-id="2">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_calm</i>
                                            </div>
                                            <h6>Calmo</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-3" data-emotion-id="3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_neutral</i>
                                            </div>
                                            <h6>Neutro</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-4" data-emotion-id="4">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_worried</i>
                                            </div>
                                            <h6>Ansioso</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-5" data-emotion-id="5">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_sad</i>
                                            </div>
                                            <h6>Triste</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-6" data-emotion-id="6">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_extremely_dissatisfied</i>
                                            </div>
                                            <h6>Raiva</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-7" data-emotion-id="7">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">mood</i>
                                            </div>
                                            <h6>Aliviado</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Você ainda precisa de ajuda?</h5>
                                <div>
                                    Busque ajuda presencialmente nas salas: <strong>D-19 ou D-01</strong>
                                </div>

                            </div>

                        </div>


                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-secondary me-md-2" id="clearEntryBtn">Limpar</button>
                            <button class="btn btn-primary" id="saveEntryBtn">Salvar Entrada</button>
                        </div>



                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
<script src="/javascripts/oaut.js"></script>
<script>
    // Emoções disponíveis
    const emotions = [
        {id: 1, name: "Feliz", icon: "sentiment_excited", color: "emotion-color-1"},
        {id: 2, name: "Calmo", icon: "sentiment_calm", color: "emotion-color-2"},
        {id: 3, name: "Neutro", icon: "sentiment_neutral", color: "emotion-color-3"},
        {id: 4, name: "Ansioso", icon: "sentiment_stressed", color: "emotion-color-4"},
        {id: 5, name: "Triste", icon: "sentiment_dissatisfied", color: "emotion-color-5"},
        {id: 6, name: "Raiva", icon: "sentiment_extremely_dissatisfied", color: "emotion-color-6"},
        {id: 7, name: "Aliviado", icon: "sentiment_content", color: "emotion-color-7"},
    ];

    // Inicialização da aplicação
    document.addEventListener('DOMContentLoaded', function () {
        initializeEmotionsGrid();
    });

    // Inicializa a grade de emoções
    function initializeEmotionsGrid() {
        const emotionsGrid = document.querySelectorAll('.emotionsGrid');
        emotionsGrid.forEach(emotion => {
            renderEmotionsGrid(emotion);
        })
    }

    function renderEmotionsGrid(emotionsGrid) {
        emotions.forEach(emotion => {
            const col = document.createElement('div');
            col.className = 'col-6 col-md-4 col-lg-2';

            const card = document.createElement('div');
            card.className = `card emotion-card text-center p-3 ${emotion.color}`;
            card.dataset.emotionId = emotion.id;

            card.innerHTML = `
                    <div class="emotion-icon">
                        <i class="material-symbols-outlined ">${emotion.icon}</i>
                    </div>
                    <h6 id="name">${emotion.name}</h6>
                `;

            card.addEventListener('click', function () {
                selectEmotion(emotion.id);
            });

            col.appendChild(card);
            emotionsGrid.appendChild(col);
        });
    }


    // Seleciona uma emoção
    function selectEmotion(emotionId) {
        selectedEmotion = emotionId;

        // Remove a seleção anterior
        const emotionsGrid = document.getElementById('emotionsGrid');
        emotionsGrid.querySelectorAll('.emotion-card').forEach(card => {
            card.classList.remove('selected-emotion');
        });

        // Adiciona a seleção à emoção clicada
        const selectedCard = document.querySelector(`.emotion-card[data-emotion-id="${emotionId}"]`);
        selectedCard.classList.add('selected-emotion');
    }

    const emotionsGrid2 = document.getElementById('emotionsGrid2');
    const emotinsCards = emotionsGrid2.querySelectorAll('.emotion-card');

    emotinsCards.forEach(emotion => {
        emotion.addEventListener('click', function () {
            emotinsCards.forEach(card => {
                card.classList.remove('selected-emotion');
            });
            emotion.classList.add('selected-emotion');
        });
    });

    async function saveEntry() {
        const diario = {
            emocao_inicial: '',
            emocao_final: '',
            influenciado: [],
            acoes: [],
            diario: ''
        }

        const emotionsGrid1 = document.getElementById('emotionsGrid');
        const emocoes_inicial = emotionsGrid1.querySelectorAll('.selected-emotion');
        if (emocoes_inicial.length > 0) {
            emocoes_inicial.forEach(emotion => {
                const id = emotion.getAttribute('data-emotion-id');
                diario.emocao_inicial = emotions[id - 1].name;
            })
        } else {
            alert('Selecione uma Emoção');
            return;
        }

        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                diario.influenciado.push(checkbox.value);
            }
        });

        if (!diario.influenciado.length > 0) {
            alert('Selecione uma Influencia para a Emoção');
            return;
        }

        const diario_text = document.getElementById('diario_text');
        diario.diario = diario_text.value;
        const poss1 = document.getElementById('possibilidade1');
        const poss2 = document.getElementById('possibilidade2');
        const poss3 = document.getElementById('possibilidade3');
        diario.acoes.push(poss1.value);
        diario.acoes.push(poss2.value);
        diario.acoes.push(poss3.value);

        console.log(diario.acoes);

        const emotionsGrid2 = document.getElementById('emotionsGrid2');
        const emocoes_inicial2 = emotionsGrid2.querySelectorAll('.selected-emotion');
        if (emocoes_inicial2.length > 0) {
            emocoes_inicial2.forEach(emotion => {
                const id = emotion.getAttribute('data-emotion-id');
                diario.emocao_final = emotions[id - 1].name;
            })
        } else {
            alert('Selecione uma Emoção de como sente agora?');
            return;
        }

        try {
            const response = await fetch('/api/diario/novo', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                credentials: 'include',
                body: JSON.stringify(diario)
            });
            const resultado = await response.json();
            if (resultado.success) {
                alert('Diario Salvo com Sucesso!');
            }
        } catch (error) {
            console.error('Erro ao enviar questionário:', error);
            alert('Erro ao enviar o Diario de Emoções. Tente novamente.');
        }
    }

    // Limpa o formulário de nova entrada
    function clearEntryForm() {
        const emotionsGrid1 = document.getElementById('emotionsGrid');
        const emocoes_inicial = emotionsGrid1.querySelectorAll('.selected-emotion');
        emocoes_inicial.forEach(emotion => {
            emotion.classList.remove('selected-emotion');
        });
        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                checkbox.checked = false;
            }
        });
        document.getElementById('diario_text').value = '';
        document.getElementById('possibilidade1').value = '';
        document.getElementById('possibilidade2').value = '';
        document.getElementById('possibilidade3').value = '';

        const emotionsGrid2 = document.getElementById('emotionsGrid2');
        const emocoes_final = emotionsGrid2.querySelectorAll('.selected-emotion');
        emocoes_final.forEach(emotion => {
            emotion.classList.remove('selected-emotion');
        });

    }

    document.getElementById('saveEntryBtn').addEventListener('click', saveEntry);
    document.getElementById('clearEntryBtn').addEventListener('click', clearEntryForm);

</script>
</body>
</html>