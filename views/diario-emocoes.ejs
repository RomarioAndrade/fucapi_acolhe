<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                             class="d-inline-block align-text-top">
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-right: 10px">theater_comedy</span>
                    Diario Emoções
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <div style="display:flex;align-items: center">
                    <div style="margin: auto 10px auto 10px;text-align: center;align-items: center;">
                        <span class="material-symbols-outlined" style="margin-top: 4px;">aod_watch</span>
                        Conectado
                        <i class="fa-solid fa-circle" style="color: chartreuse;margin-left: 5px;"></i>
                    </div>
                    65 Bpm
                    <i class="fa-solid fa-heart" style="color: red;margin: auto"></i>
                </div>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item" onclick="navigation('dashboard')">
                        <span class="material-symbols-outlined">space_dashboard</span>
                        Dashboard
                    </li>
                    <li id="meudiafucapi" class="menu-item active" onclick="navigation('meudiafucapi')">
                        <span class="material-symbols-outlined">clear_day</span>
                        Meu Dia FUCAPI
                    </li>
                    <li id="conectafucapi" class="menu-item" onclick="navigation('conectafucapi')">
                        <span class="material-symbols-outlined">diversity_2</span>
                        Conecta FUCAPI

                    </li>
                    <li id="espacocalma" class="menu-item">
                        <span class="material-symbols-outlined">psychiatry</span>
                        Espaço Calma
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">ent</span>
                        Perfil de Usuário
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">notifications</span>
                        Notificações
                    </li>
                    <% if(user.papel !== 'aluno' ){ %>
                        <li class="menu-item">
                            <i class="fa-solid fa-table-list"></i>
                            Lista Alunos
                        </li>
                        <li class="menu-item">
                            <i class="fa-solid fa-message"></i>
                            Chat
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="main-content">
            <div class="container mt-2">
                <!-- Nova Entrada -->
                <div id="newEntrySection">
                    <div class="card shadow-sm col-9" style="margin: auto">
                        <div class="card-header bg-white">
                            <h4 class="mb-0"></i> Nova Entrada no Diário</h4>
                        </div>
                        <div class="card-body diary">

                            <div class="mb-4">
                                <h5>Como você está se sentindo?</h5>
                                <div class="row g-3" id="emotionsGrid">
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-2">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_satisfied</i>
                                            </div>
                                            <h6>Feliz</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_calm</i>
                                            </div>
                                            <h6>Calmo</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-6">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_neutral</i>
                                            </div>
                                            <h6>Neutro</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-5">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_worried</i>
                                            </div>
                                            <h6>Ansioso</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-4">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_sad</i>
                                            </div>
                                            <h6>Triste</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3 emotion-color-1">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_extremely_dissatisfied</i>
                                            </div>
                                            <h6>Raiva</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">mood</i>
                                            </div>
                                            <h6>Aliviado</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4" id="intensitySection" style="display: none;">
                                <h5>Intensidade da emoção</h5>

                                <input type="range" class="intensity-slider" id="emotionIntensity" min="1" max="10"
                                       value="5">
                                <div class="d-flex justify-content-between">
                                    <small>Leve</small>
                                    <small>Moderada</small>
                                    <small>Intensa</small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5>O que pode estar Influenciando?</h5>
                                <div class="d-flex flex-wrap mb-2">
                                    <div class="" role="group" aria-label="Basic checkbox toggle button group">
                                        <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck1">Provas/Trabalhos</label>

                                        <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck2">Interação Social</label>

                                        <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck3">Barulho/Ambiente</label>

                                        <input type="checkbox" class="btn-check" id="btncheck4" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck4">Mudança de Rotina</label>

                                        <input type="checkbox" class="btn-check" id="btncheck5" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="btncheck5">Cansaço</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>O que está acontecendo? Diário do Dia</h5>
                                <textarea class="form-control" id="entryDescription" rows="4"
                                          placeholder="Descreva o que está sentindo e o que aconteceu..."></textarea>
                            </div>

                            <div class="mb-4">
                                <h5>Como posso lidar com isso?</h5>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 1..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                                <div class="mb-4">
                                    <textarea class="form-control" id="entryDescription" rows="1"
                                              placeholder="Possibilidade 2..."></textarea>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Depois de refletir, como você se sente agora?</h5>
                            </div>
                            <div class="mb-4">
                                <div class="row g-3" id="emotionsGrid">
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_satisfied</i>
                                            </div>
                                            <h6>Feliz</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_calm</i>
                                            </div>
                                            <h6>Calmo</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_neutral</i>
                                            </div>
                                            <h6>Neutro</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_worried</i>
                                            </div>
                                            <h6>Ansioso</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_sad</i>
                                            </div>
                                            <h6>Triste</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">sentiment_extremely_dissatisfied</i>
                                            </div>
                                            <h6>Raiva</h6>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card emotion-card text-center p-3">
                                            <div class="emotion-icon">
                                                <i class="material-symbols-outlined">mood</i>
                                            </div>
                                            <h6>Aliviado</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <h5>Você ainda precisa de ajuda?</h5>
                                <div>
                                    Busque ajuda presencialmente nas salas: <strong>D-19 ou D-01</strong>
                                </div>

                            </div>

                        </div>


                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-secondary me-md-2" id="clearEntryBtn">Limpar</button>
                            <button class="btn btn-primary" id="saveEntryBtn">Salvar Entrada</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/navigation.js"></script>
</body>
</html>