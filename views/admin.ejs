<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <a class="navbar-brand" href="#">
                    <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                         class="d-inline-block align-text-top">
                    FUCAPI Acolhe
                </a>
            </div>
            <div>Dashboard</div>


        </div>

    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item active">
                        <i class="fa-solid fa-message"></i>
                        Chat
                    </li>
                </ul>
            </div>
            <div style="height: 50px">
                <div>

                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="card c-height">
                <div class="card-header">
                    Conversas
                </div>
                <div class="card-body">
                    <div class="card-body-main">
                        <div class="contato-chat">
                            <div class="contato-chat-title">
                                <label>Contatos</label>
                                <input id="" class="form-control" type="text" placeholder="Pesquisa contatos"
                                       aria-label="default input example" >
                            </div>
                            <div id="conversations-list">

                            </div>
                        </div>
                        <div class="chat-main">
                            <div id="chat-user-title" class="chat-main-title"></div>
                            <div class="chat-main-content" id="scroll-messages">
                                <div class="chat-conversation" id="messages-container">
                                    <div style="align-content: center;
                                                  text-align: center;
                                                  justify-content: center;
                                                  display: flex;
                                                  flex-direction: column;
                                                  flex-grow: 1;">

                                        <i class="fa-solid fa-comment-dots" style="font-size: 200px;color: #258ee6"></i>
                                        <h1>Nenhuma conversa selecionada</h1>
                                    </div>

                                </div>

                            </div>
                            <div class="chat-conversation-input">
                                <div class="chat-file">
                                    <i class="fa-solid fa-paperclip"></i>
                                </div>
                                <div class="chat-input">
                                    <input id="message-text" class="form-control" type="text" placeholder="Default input"
                                           aria-label="default input example" disabled onkeydown="handleKeyPress(event)">
                                </div>
                                <div>
                                    <button class="btn btn-primary" type="button" onclick="sendMessage()">
                                        <i class="fa-solid fa-paper-plane"></i> Enviar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>