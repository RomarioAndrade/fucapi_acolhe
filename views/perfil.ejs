<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <a class="navbar-brand" href="#">
<!--                    <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"-->
<!--                         class="d-inline-block align-text-top">-->
                    FUCAPI Acolhe
                </a>
            </div>
            <div>Dashboard</div>
            <% if(user.papel === 'aluno'){ %>
                <div style="display:flex;align-items: center">
                    <div style="margin: auto 10px auto 10px">
                        Conected
                        <i class="fa-solid fa-circle" style="color: chartreuse"></i>
                    </div>
                    65 Bpm
                    <i class="fa-solid fa-heart" style="color: red;margin: auto"></i>
                </div>
            <% } %>
        </div>

    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item active">
                        <i class="fa-solid fa-house-user"></i>
                        Dashboard
                    </li>
                    <% if(user.papel !== 'aluno'){ %>
                        <li class="menu-item">
                            <i class="fa-solid fa-table-list"></i>
                            Lista Alunos
                        </li>
                        <li class="menu-item">
                            <i class="fa-solid fa-message"></i>
                            Chat
                        </li>
                    <% } %>
                </ul>
            </div>
            <div style="height: 50px;
                        border-top: 1px solid rgba(0, 0, 0, 0.1);">
                <div>
                    <div class="dropdown">
                        <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="fa-solid fa-gear"></i><%= user.username %>
                        </a>

                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" onclick="logout()">Logout</a></li>
                            <li><a class="dropdown-item" href="#">Configurações</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="card">

            </div>

        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
<script src="/javascripts/oaut.js"></script>
</body>
</html>