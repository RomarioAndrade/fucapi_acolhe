<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
<!--                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"-->
<!--                             class="d-inline-block align-text-top">-->
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-top: 4px">space_dashboard</span>
                    Dashboard
                </div>
            </div>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <%- include('partials/sidebar')%>
        </div>
        <div class="main-content">
            <div class="card cardio-card" style="">
                <span class="material-symbols-outlined">aod_watch</span>
                <div class="cardio-item">Status da Pulseira:</div>
                <div id="connectionStatus" class="cardio-item" style="color: green">--</div>
                <div class="cardio-item">Batimentos Cardíacos:</div>
                <div id="currentBpm" class="cardio-item"><strong>-- Bpm</strong>
                </div>
                <span class="material-symbols-outlined pulse-animation" style="margin:0px 10px;color: red">cardiology</span>

            </div>
            <div style="padding: 10px;">
                <h2>Acesso Rápido</h2>
            </div>
            <div style="display: flex;flex-direction: row;">
                <div class="col" style="display: flex;">
                    <a href="/dashboard/agenda" style="text-decoration: none;color: black;">
                    <div class="d-button" onclick="navigation('agenda')">
                        <span class="material-symbols-outlined d-spam">calendar_month</span>
                        <strong>Agenda</strong>
                    </div>
                    </a>
                    <a href="/dashboard/chat" style="text-decoration: none;color: black;">
                    <div class="d-button" onclick="navigation('chat')">
                        <span class="material-symbols-outlined d-spam">chat_bubble</span>
                        <strong>Canal de Comunicação</strong>
                    </div>
                    </a>
                    <a href="/dashboard/foco" style="text-decoration: none;color: black;">
                    <div class="d-button" onclick="navigation('foco')">
                        <span class="material-symbols-outlined d-spam">
                            nest_clock_farsight_analog</span>
                        <strong>Gestor de Foco</strong>
                    </div>
                    </a>
                    <a href="/dashboard/respiracao-guiada" style="text-decoration: none;color: black;">
                    <div class="d-button" onclick="navigation('respiracao-guiada')">
                        <span class="material-symbols-outlined d-spam">
                            pulmonology</span>
                        <strong>Respiração Guiada</strong>
                    </div>
                    </a>
                    <a href="/dashboard/diario-emocoes" style="text-decoration: none;color: black;">
                    <div class="d-button" onclick="navigation('diario-emocoes')">
                        <span class="material-symbols-outlined d-spam">
                            theater_comedy</span>
                        <strong>Diário de Emoções</strong>
                    </div>
                    </a>
                </div>
            </div>
            <div>
                <canvas id="emotionChart"></canvas>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
<script src="/javascripts/oaut.js"></script>
<script>
    let chart;
    let diarios

    // Configuração do gráfico
    function initializeChart() {
        const ctx = document.getElementById('emotionChart').getContext('2d');
        chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Diario de Emoções',
                    data: [],
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: false,
                        suggestedMin: 40,
                        suggestedMax: 160
                    }
                },
                plugins: {
                    legend: {
                        display: true
                    }
                }
            }
        });
    }

    async function updateChart() {
        try {
            const response = await fetch('/api/diarios', {
                method: 'GET',
                credentials: 'include'
            });

            if (response.ok) {
                diarios = await response.json();

                if (diarios.length > 0) {
                    diarios.forEach((diario) => {
                        const timeLabel = new Date(diario.data).toLocaleTimeString();
                        chart.data.labels.push(timeLabel);
                        chart.data.datasets[0].data.push(diario.emocao_inicial);

                        // Mantém apenas os últimos 20 pontos no gráfico
                        if (chart.data.labels.length > 20) {
                            chart.data.labels.shift();
                            chart.data.datasets[0].data.shift();
                        }


                    });
                    chart.update();
                }
            } else {
                throw new Error('Falha ao carregar Diarios');
            }
        } catch (error) {
            console.error('Falha ao carregar Diarios:', error);
            alert('Falha ao carregar Diarios: ' + error.message);
        }



    }


</script>
</body>
</html>