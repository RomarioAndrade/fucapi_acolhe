<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                             class="d-inline-block align-text-top">
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-top: 4px">space_dashboard</span>
                    Dashboard
                </div>
                <div>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <Dropdown button>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Action</a></li>
                            <li><a class="dropdown-item" href="#">Another action</a></li>
                            <li><a class="dropdown-item" href="#">Something else here</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item active" onclick="navigation('dashboard')">
                        <span class="material-symbols-outlined">space_dashboard</span>
                        Dashboard
                    </li>
                    <li id="meudiafucapi" class="menu-item" onclick="navigation('meudiafucapi')">
                        <span class="material-symbols-outlined">clear_day</span>
                        Meu Dia FUCAPI
                    </li>
                    <li id="conectafucapi" class="menu-item" onclick="navigation('conectafucapi')">
                        <span class="material-symbols-outlined">diversity_2</span>
                        Conecta FUCAPI
                    </li>
                    <li id="espacocalma" class="menu-item">
                        <span class="material-symbols-outlined">psychiatry</span>
                        Espaço Calma
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">ent</span>
                        Perfil de Usuário
                    </li>
                </ul>
            </div>
        </div>
        <div class="main-content">
            <div class="card" style="padding: 20px;background: #e6f4fe;display: flex;flex-direction: row;">
                <span class="material-symbols-outlined">aod_watch</span>
                <div style="margin-left: 10px;margin-right: 10px;">Status da Pulseira:</div>
                <p style="color: green"><strong>conectado</strong></p>
                <div style="margin-left: 10px;">Batimentos Cardíacos:</div>
                <div style="margin-left: 10px;display: flex;flex-direction: row;"><strong>-- Bpm</strong>
                    <span class="material-symbols-outlined" style="margin:0px 10px;color: red">cardiology</span>
                </div>
                <div style="margin-left: 10px;">Ultima Atualização:</div>
                <div>10/11/2025 00:00</div>
            </div>
            <div style="padding: 10px;">
                <h2>Acesso Rápido</h2>
            </div>
            <div style="display: flex;flex-direction: row;">
                <div class="col" style="display: flex;">
                    <div class="d-button">
                        <span class="material-symbols-outlined"
                              style="margin-right: 10px;color: #ff5400;font-size: 35px;">calendar_month</span>
                        <strong>Agenda</strong>
                    </div>
                    <div class="d-button">
                        <span class="material-symbols-outlined"
                              style="margin-right: 10px;color: #00771c;font-size: 35px;">chat_bubble</span>
                        <strong>Canal de Comunicação</strong>
                    </div>
                    <div class="d-button">
                        <span class="material-symbols-outlined"
                              style="margin-right: 10px;color: #ff0062;font-size: 35px;">nest_clock_farsight_analog</span>
                        <strong>Gestor de Foco</strong>
                    </div>
                </div>
            </div>
            <div>
                Grafico
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
</body>
</html>