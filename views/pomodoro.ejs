<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fucapi Acolhe - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/script.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
<!--                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"-->
<!--                             class="d-inline-block align-text-top">-->
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined" style="margin-top: 4px">space_dashboard</span>
                    Dashboard
                    <span class="material-symbols-outlined" style="margin-top: 4px">chevron_forward</span>
                    Foco
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <%- include('partials/cardio')%>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <%- include('partials/sidebar')%>
        </div>


        <div class="main-content">
            <div class="container">
                <div class="pomodoro-container" id="pomodoroContainer">
                    <h1 class="text-center pomodoro-title">Gestor de Foco</h1>
                    <p class="text-center">Trabalhe com foco total, descanse com tranquilidade</p>

                    <div class="text-center timer-display" id="timerDisplay">25:00</div>

                    <div class="progress">
                        <div class="progress-bar" id="progressBar" role="progressbar" style="width: 100%"></div>
                    </div>

                    <div class="text-center timer-controls">
                        <button class="btn btn-success btn-pomodoro" id="startBtn">
                            <i class="bi bi-play-fill"></i> Iniciar
                        </button>
                        <button class="btn btn-warning btn-pomodoro" id="pauseBtn" disabled>
                            <i class="bi bi-pause-fill"></i> Pausar
                        </button>
                        <button class="btn btn-danger btn-pomodoro" id="resetBtn">
                            <i class="bi bi-arrow-clockwise"></i> Reiniciar
                        </button>
                    </div>

                    <div class="text-center session-info">
                        <p>Sessão: <span id="sessionCount">1</span> de 4</p>
                        <p id="statusMessage">Pronto para começar!</p>
                    </div>

                    <div class="settings-panel">
                        <h5><i class="bi bi-gear-fill"></i> Configurações</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="workDuration" class="form-label">Duração do trabalho (minutos)</label>
                                <input type="number" class="form-control" id="workDuration" min="1" max="60" value="25">
                            </div>
                            <div class="col-md-6">
                                <label for="breakDuration" class="form-label">Duração da pausa (minutos)</label>
                                <input type="number" class="form-control" id="breakDuration" min="1" max="30" value="5">
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-primary" id="applySettings">
                                <i class="bi bi-check-lg"></i> Aplicar Configurações
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/navigation.js"></script>
<script src="/javascripts/oaut.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Elementos DOM
        const timerDisplay = document.getElementById('timerDisplay');
        const startBtn = document.getElementById('startBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        const resetBtn = document.getElementById('resetBtn');
        const progressBar = document.getElementById('progressBar');
        const sessionCount = document.getElementById('sessionCount');
        const statusMessage = document.getElementById('statusMessage');
        const workDurationInput = document.getElementById('workDuration');
        const breakDurationInput = document.getElementById('breakDuration');
        const applySettingsBtn = document.getElementById('applySettings');
        const pomodoroContainer = document.getElementById('pomodoroContainer');

        // Variáveis do timer
        let workTime = 25 * 60; // 25 minutos em segundos
        let breakTime = 5 * 60; // 5 minutos em segundos
        let currentTime = workTime;
        let isWorkSession = true;
        let isRunning = false;
        let timerInterval;
        let sessionsCompleted = 0;
        let totalTime = workTime;

        // Atualizar display do timer
        function updateDisplay() {
            const minutes = Math.floor(currentTime / 60);
            const seconds = currentTime % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            // Atualizar barra de progresso
            const progressPercentage = (currentTime / totalTime) * 100;
            progressBar.style.width = `${progressPercentage}%`;

            // Atualizar cores e mensagens baseado no modo
            if (isWorkSession) {
                progressBar.className = 'progress-bar bg-danger';
                statusMessage.textContent = 'Tempo de trabalho';
                pomodoroContainer.classList.remove('break-mode');
                pomodoroContainer.classList.add('work-mode');
            } else {
                progressBar.className = 'progress-bar bg-success';
                statusMessage.textContent = 'Tempo de descanso';
                pomodoroContainer.classList.remove('work-mode');
                pomodoroContainer.classList.add('break-mode');
            }
        }

        // Iniciar o timer
        function startTimer() {
            if (!isRunning) {
                isRunning = true;
                startBtn.disabled = true;
                pauseBtn.disabled = false;

                timerInterval = setInterval(function() {
                    currentTime--;

                    if (currentTime < 0) {
                        // Timer chegou a zero
                        clearInterval(timerInterval);
                        isRunning = false;

                        // Reproduzir som de notificação
                        playNotificationSound();

                        if (isWorkSession) {
                            // Terminou uma sessão de trabalho
                            sessionsCompleted++;
                            sessionCount.textContent = sessionsCompleted;

                            // Verificar se é hora de uma pausa longa
                            if (sessionsCompleted % 4 === 0) {
                                alert('Parabéns! Você completou 4 sessões. Hora de uma pausa longa!');
                                currentTime = breakTime * 2; // Pausa longa = 2x a pausa normal
                            } else {
                                alert('Sessão de trabalho concluída! Hora de uma pausa.');
                                currentTime = breakTime;
                            }

                            isWorkSession = false;
                        } else {
                            // Terminou uma pausa
                            alert('Pausa concluída! Hora de voltar ao trabalho.');
                            currentTime = workTime;
                            isWorkSession = true;
                        }

                        totalTime = currentTime;
                        updateDisplay();
                        startTimer(); // Reiniciar automaticamente
                    } else {
                        updateDisplay();
                    }
                }, 1000);
            }
        }

        // Pausar o timer
        function pauseTimer() {
            if (isRunning) {
                clearInterval(timerInterval);
                isRunning = false;
                startBtn.disabled = false;
                pauseBtn.disabled = true;
            }
        }

        // Reiniciar o timer
        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            currentTime = workTime;
            totalTime = workTime;
            isWorkSession = true;
            sessionsCompleted = 0;
            sessionCount.textContent = '1';
            startBtn.disabled = false;
            pauseBtn.disabled = true;
            updateDisplay();
            statusMessage.textContent = 'Pronto para começar!';
            pomodoroContainer.classList.remove('work-mode', 'break-mode');
        }

        // Aplicar configurações
        function applySettings() {
            const newWorkTime = parseInt(workDurationInput.value) * 60;
            const newBreakTime = parseInt(breakDurationInput.value) * 60;

            if (newWorkTime > 0 && newBreakTime > 0) {
                workTime = newWorkTime;
                breakTime = newBreakTime;

                // Se não estiver rodando, atualizar o display
                if (!isRunning) {
                    currentTime = workTime;
                    totalTime = workTime;
                    updateDisplay();
                }

                alert('Configurações aplicadas com sucesso!');
            } else {
                alert('Por favor, insira valores válidos para as durações.');
            }
        }

        // Reproduzir som de notificação
        function playNotificationSound() {
            // Criar um contexto de áudio
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();

            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);

            oscillator.type = 'sine';
            oscillator.frequency.value = 800;
            gainNode.gain.value = 0.1;

            oscillator.start();

            // Parar após 500ms
            setTimeout(function() {
                oscillator.stop();
            }, 500);
        }

        // Event Listeners
        startBtn.addEventListener('click', startTimer);
        pauseBtn.addEventListener('click', pauseTimer);
        resetBtn.addEventListener('click', resetTimer);
        applySettingsBtn.addEventListener('click', applySettings);

        // Inicializar display
        updateDisplay();
    });
</script>
</body>
</html>