<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Respiração Guiada</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/bootstrap.bundle.js"></script>
    <link rel="stylesheet" href="/stylesheets/temp.css">
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>
<div class="main-container">
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <div style="display:flex;flex-direction: row">
                <div style="display:flex;flex-direction: row;width: 207px;">
                    <a class="navbar-brand" href="#">
                        <img src="/images/logo 64x64.png" alt="Logo" width="30" height="24"
                             class="d-inline-block align-text-top">
                        FUCAPI Acolhe
                    </a>
                </div>
                <div style="text-align: center;align-content: center;margin-left: 20px;border-radius: 5px;background: #eee;
                            padding: 5px 10px 5px 10px;display: flex;flex-direction: row;justify-items: center;
                            align-items: center;
                            flex-wrap: nowrap;">
                    <span class="material-symbols-outlined"
                          style="margin-top: 4px;margin-right:10px; ">pulmonology</span>
                    Respiração Guiada
                </div>
            </div>

            <% if(user.papel === 'aluno' ){ %>
                <div style="display:flex;align-items: center">
                    <div style="margin: auto 10px auto 10px;text-align: center;align-items: center;">
                        <span class="material-symbols-outlined" style="margin-top: 4px;">aod_watch</span>
                        Conectado
                        <i class="fa-solid fa-circle" style="color: chartreuse;margin-left: 5px;"></i>
                    </div>
                    65 Bpm
                    <i class="fa-solid fa-heart" style="color: red;margin: auto"></i>
                </div>
            <% } %>
        </div>
    </nav>
    <div class="container-sub">
        <div class="sidebar">
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="menu-item" onclick="navigation('dashboard')">
                        <span class="material-symbols-outlined">space_dashboard</span>
                        Dashboard
                    </li>
                    <li id="meudiafucapi" class="menu-item active" onclick="navigation('meudiafucapi')">
                        <span class="material-symbols-outlined">clear_day</span>
                        Meu Dia FUCAPI
                    </li>
                    <li id="conectafucapi" class="menu-item" onclick="navigation('conectafucapi')">
                        <span class="material-symbols-outlined">diversity_2</span>
                        Conecta FUCAPI

                    </li>
                    <li id="espacocalma" class="menu-item">
                        <span class="material-symbols-outlined">psychiatry</span>
                        Espaço Calma
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">ent</span>
                        Perfil de Usuário
                    </li>
                    <li id="perfilusuario" class="menu-item">
                        <span class="material-symbols-outlined">notifications</span>
                        Notificações
                    </li>
                    <% if(user.papel !== 'aluno' ){ %>
                        <li class="menu-item">
                            <i class="fa-solid fa-table-list"></i>
                            Lista Alunos
                        </li>
                        <li class="menu-item">
                            <i class="fa-solid fa-message"></i>
                            Chat
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>


        <div class="main-content">
            <div class="container">

                <div class="card shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="mb-0">Técnica de Respiração 4-7-8</h4>
                            <div class="small-muted">Uma técnica simples para reduzir o estresse e promover o
                                relaxamento
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-5 mb-3 mb-md-0">
                            <div class="border rounded p-3 bg-white">
                                <div class="breathing-circle" id="breathingCircle">
                                    <div class="timer" id="timer">00</div>
                                </div>
                                <div class="instruction" id="instruction">Clique em Iniciar para começar</div>

                                <div class="text-center mb-3">
                                    <button class="btn btn-success me-2" id="startBtn">
                                        <i class="fas fa-play me-2"></i>Iniciar
                                    </button>
                                    <button class="btn btn-warning me-2" id="pauseBtn" disabled>
                                        <i class="fas fa-pause me-2"></i>Pausar
                                    </button>
                                    <button class="btn btn-danger" id="resetBtn">
                                        <i class="fas fa-redo me-2"></i>Reiniciar
                                    </button>
                                </div>

                                <div class="phase-indicator">
                                    <div class="phase" id="phase1">Inspirar</div>
                                    <div class="phase" id="phase2">Segurar</div>
                                    <div class="phase" id="phase3">Expirar</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-7 mb-3 mb-md-0">
                            <div class="border rounded p-3 bg-white">
                                <div class="settings-panel">
                                    <h5><span class="material-symbols-outlined">settings</span>Configurações</h5>
                                    <div class="">
                                        <label for="inhaleTime" class="form-label">Tempo de Inspiração
                                            (segundos)</label>
                                        <input type="range" class="form-range" id="inhaleTime" min="2" max="8" step="1"
                                               value="4">
                                        <div class="text-center" id="inhaleValue">4 segundos</div>
                                    </div>
                                    <div class="">
                                        <label for="holdTime" class="form-label">Tempo de Retenção (segundos)</label>
                                        <input type="range" class="form-range" id="holdTime" min="4" max="12" step="1"
                                               value="7">
                                        <div class="text-center" id="holdValue">7 segundos</div>
                                    </div>
                                    <div class="">
                                        <label for="exhaleTime" class="form-label">Tempo de Expiração (segundos)</label>
                                        <input type="range" class="form-range" id="exhaleTime" min="4" max="12" step="1"
                                               value="8">
                                        <div class="text-center" id="exhaleValue">8 segundos</div>
                                    </div>
                                </div>

<!--                                <div class="technique-info mt-4">-->
<!--                                    <h5><i class="fas fa-info-circle me-2"></i>Sobre a Técnica 4-7-8</h5>-->
<!--                                    <p>A técnica de respiração 4-7-8 é um método simples mas poderoso que pode ajudar-->
<!--                                        a:</p>-->
<!--                                    <ul class="benefits-list">-->
<!--                                        <li>Reduzir a ansiedade e o estresse</li>-->
<!--                                        <li>Melhorar a qualidade do sono</li>-->
<!--                                        <li>Aumentar a concentração</li>-->
<!--                                        <li>Promover relaxamento profundo</li>-->
<!--                                        <li>Regular o sistema nervoso</li>-->
<!--                                    </ul>-->
<!--                                </div>-->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/javascripts/guidedbreathing.js"></script>
    <script src="/javascripts/navigation.js"></script>
</body>
</html>