<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css'/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script src="/javascripts/oaut.js" type="text/javascript"></script>
</head>
<body>

<div class="container-fluid login">
    <div style="display:table;margin: 150px auto 5px auto;">
        <div style="background: white;border-radius: 10px;min-width: 350px;min-height: 300px;margin: auto;">
            <div style="display: flex;justify-content: center;align-items: center;flex-direction: column;padding: 10px">
                <div style="color:rgb(3, 49, 74); margin-top: 10px;">
                    <h4>Fucapi Acolhe</h4>
                </div>
                <div>Acesse sua conta</div>
            </div>
            <div style="display: flex;justify-content: center;align-items: center;flex-direction: column;">
                <div style="padding: 10px">
                    <input id="login-username" style="background: #f2f2f2;" class="form-control" type="text" placeholder="Email Address">
                </div>
                <div style="padding: 10px">
                    <input id="login-password" style="background: #f2f2f2;" class="form-control" type="password" placeholder="Password">
                </div>
                <div id="messages" style="height: 24px;color: red">

                </div>
                <div style="padding: 10px;flex-grow: 1">
                    <button id="entrar" onclick="login()"
                            style="width: 220px;" type="button" class="btn btn-primary">Entrar</button>
                </div>

            </div>
        </div>
    </div>
</div>
</body>
</html>
